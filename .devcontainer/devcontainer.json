{
  "name": "CS-215 Digital Design Labs",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "mshr-h.veriloghdl",
        "lramseyer.vaporview",
        "-GitHub.copilot",
        "-GitHub.copilot-chat"
      ],
      "settings": {
        "chat.disableAIFeatures": true,
        "workbench.secondarySideBar.defaultVisibility": "visible",
        "extensions.autoUpdate": false
      }
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "chmod +x scripts/*.sh && ./scripts/install_extension.sh"
}
